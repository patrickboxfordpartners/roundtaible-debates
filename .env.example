# Database (Neon Postgres). Server-side only; used by the /api functions.
DATABASE_URL=

# Clerk auth
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AI debate turns (xAI). Server-side only.
XAI_API_KEY=
# Optional overrides
# XAI_MODEL=grok-4.3
# XAI_REASONING_EFFORT=none

# Premium voices (ElevenLabs). Server-side only. Without it the browser voice is used.
ELEVENLABS_API_KEY=

# Stripe. Secret key and webhook secret are server-side only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs (VITE_ prefix for frontend access; the server also uses them as the allowed list)
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_YEARLY=
VITE_STRIPE_PRICE_EDU_MONTHLY=
VITE_STRIPE_PRICE_EDU_YEARLY=

# Welcome email (Postmark). Server-side only.
POSTMARK_API_KEY=

# PostHog analytics
VITE_POSTHOG_KEY=

# Unsplash (login page photo)
VITE_UNSPLASH_ACCESS_KEY=

# Boxford CRM intake for the contact form. Server-side only.
CRM_INTAKE_URL=https://boxford-crm.vercel.app
CRM_INTAKE_KEY=
